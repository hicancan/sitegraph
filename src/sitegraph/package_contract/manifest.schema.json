{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sitegraph:site-package:manifest",
  "title": "SitePackage manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "site_id",
    "started_at",
    "finished_at",
    "totals",
    "errors"
  ],
  "properties": {
    "format": {
      "const": "sitegraph-package-v4"
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections",
        "nav_nodes",
        "homepage_modules",
        "list_pages",
        "detail_pages",
        "empty_content",
        "unrecognized_page_type",
        "attachments",
        "external_links",
        "edges"
      ],
      "properties": {
        "sections": {
          "type": "integer",
          "minimum": 0
        },
        "nav_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "homepage_modules": {
          "type": "integer",
          "minimum": 0
        },
        "list_pages": {
          "type": "integer",
          "minimum": 0
        },
        "detail_pages": {
          "type": "integer",
          "minimum": 0
        },
        "empty_content": {
          "type": "integer",
          "minimum": 0
        },
        "unrecognized_page_type": {
          "type": "integer",
          "minimum": 0
        },
        "attachments": {
          "type": "integer",
          "minimum": 0
        },
        "external_links": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
